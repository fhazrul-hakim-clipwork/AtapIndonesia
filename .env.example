APP_NAME="AtapIndonesia"
APP_ENV=local
APP_KEY=base64:X/4He4BqjZZcIPZ4BfIISmDv6gZV+TxHrcdaRrz8y1U=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP (untuk email notifikasi)
# Setup: https://support.google.com/accounts/answer/185833
# 1. Aktifkan 2-Factor Authentication di Gmail
# 2. Buat App Password untuk "Mail"
# 3. Isi username (email) dan app password di bawah ini
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@atapindonesia.id"
MAIL_FROM_NAME="AtapIndonesia"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payment Gateway
# Xendit supports: VA, E-Wallet, QRIS, Credit Card, Bank Transfer
# Untuk QRIS, pastikan fitur QRIS aktif di akun Xendit Anda
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_VERIFICATION_TOKEN=
XENDIT_WEBHOOK_URL=

# Shipping APIs
LALAMOVE_KEY=
LALAMOVE_SECRET=
LALAMOVE_SANDBOX=true

DELIVEREE_KEY=
DELIVEREE_BASE_URL=https://api.deliveree.com

# Google OAuth / Gmail Login
# Setup: https://console.cloud.google.com/apis/credentials
# 1. Buat OAuth 2.0 Client ID (Web application)
# 2. Tambahkan Authorized redirect URI: http://localhost/auth/google/callback
# 3. Isi Client ID dan Client Secret di bawah ini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/auth/google/callback
